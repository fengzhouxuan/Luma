{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma",
  "version": "1.13.4",
  "identifier": "com.fengzhouxuan.luma",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Luma",
        "label": "main",
        "width": 900,
        "height": 640,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 420,
        "maxWidth": 3200,
        "maxHeight": 2160,
        "maximizable": false,
        "center": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "vendor/everything-sdk2/LICENSE": "licenses/Everything-SDK2-LICENSE.txt",
      "vendor/everything-sdk3/LICENSE": "licenses/Everything-SDK3-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
